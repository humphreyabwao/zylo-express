    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "sharp": "^0.35.3",
    "supabase": "^2.111.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.9",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
