    "build": "next build",
    "start": "next start",
    "preview": "node scripts/preview.mjs",
    "vercel:env": "bash scripts/push-vercel-env.sh",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "schema": "node scripts/build-schema.mjs",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "generate:media": "node scripts/generate-media.mjs",
    "db:types": "supabase gen types typescript --linked > src/lib/supabase/types.ts",
    "db:status": "supabase migration list",
    "db:push": "supabase db push",
    "db:new": "supabase migration new",
    "db:diff": "supabase db diff --linked"
  },
  "dependencies": {
